[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/gzip;
Actions=extractHere;
X-KDE-Priority=TopLevel

[Desktop Action extractHere]
Name=Extract here
Icon=archive-extract
Exec=ark --batch --autodestination --autosubfolder %F
